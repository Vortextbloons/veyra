+//! Keep automatic recall as a quality fallback rather than a mandatory wait.
+use super::{EngineResult, authority, intent::Intent, rank};
+use std::collections::HashMap;
+
+pub(super) fn needed(
+    query: &str,
+    intent: Intent,
+    requested: usize,
+    outcomes: &[(String, EngineResult)],
+) -> bool {
+    let primary: Vec<_> = outcomes
+        .iter()
+        .filter_map(|(engine, result)| {
+            result
+                .as_ref()
+                .ok()
+                .map(|(hits, ..)| (engine.clone(), hits.clone()))
+        })
+        .collect();
+    // A single working backend must retain the recovery opportunity.
+    if primary.iter().filter(|(_, hits)| !hits.is_empty()).count() < 2 {
+        return true;
+    }
+    let total = rank::merged_total(&primary);
+    let results = rank::merge_lexical(&primary, query, intent, &HashMap::new(), 12);
+    if results.len() < requested.clamp(1, 12) || rank::is_weak(&results, total, query) {
+        return true;
+    }
+    // Preserve scoped recall when a recognized primary source is absent.
+    // Explicit operators already suppress automatic official-source recalls.
+    if !super::query::compile(query).has_operators() {
+        for domain in authority::official_domains(query) {
+            if !results.iter().any(|result| {
+                url::Url::parse(&result.url).ok().is_some_and(|url| {
+                    url.host_str()
+                        .is_some_and(|host| host == domain || host.ends_with(&format!(".{domain}")))
+                })
+            }) {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+pub(super) async fn collect(
+    futures: Vec<(bool, super::tasks::TaskFut<'_>)>,
+    query: &str,
+    intent: Intent,
+    max_results: usize,
+    early: bool,
+) -> Vec<(String, EngineResult)> {
+    use futures_util::stream::{FuturesUnordered, StreamExt};
+    let mut remaining_primary = futures.iter().filter(|(primary, _)| *primary).count();
+    let has_recall = remaining_primary < futures.len();
+    let mut futs = FuturesUnordered::new();
+    for (primary, task) in futures {
+        futs.push(async move { (primary, task.await) });
+    }
+    let mut acc: Vec<(String, EngineResult)> = Vec::new();
+    while let Some((primary, outcome)) = futs.next().await {
+        if primary {
+            remaining_primary -= 1;
+        }
+        acc.push(outcome);
+        if early && super::early_consensus_enough(&acc) {
+            break;
+        }
+        // Keep the original concurrent recovery path for weak results.
+        // Once ALL primary lanes finish with sufficient relevant evidence
+        // and recognized official sources, cancel only optional recalls.
+        // Dropping paced futures releases their gates without reserving
+        // future admission slots (EgressPool::pace is cancellation-safe).
+        if early
+            && has_recall
+            && remaining_primary == 0
+            && !needed(query, intent, max_results, &acc)
+        {
+            break;
+        }
+    }
+    acc
+}
