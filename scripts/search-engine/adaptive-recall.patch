+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::search::engines::Hit;
+
+    fn task(
+        primary: bool,
+        delay: u64,
+        outcome: (String, EngineResult),
+    ) -> (bool, super::super::tasks::TaskFut<'static>) {
+        (
+            primary,
+            Box::pin(async move {
+                tokio::time::sleep(std::time::Duration::from_millis(delay)).await;
+                outcome
+            }),
+        )
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn returns_after_all_primary_lanes_without_waiting_for_optional_recall() {
+        let query = "James Webb Space Telescope";
+        let mut primary = outcomes(query, 12, "example.org");
+        let tasks = vec![
+            task(true, 20, primary.remove(0)),
+            task(true, 50, primary.remove(0)),
+            task(false, 2500, outcomes(query, 12, "example.org").remove(0)),
+        ];
+        let start = tokio::time::Instant::now();
+        let results = collect(tasks, query, Intent::Web, 8, true).await;
+        assert_eq!(results.len(), 2);
+        assert_eq!(start.elapsed(), std::time::Duration::from_millis(50));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn disabling_early_return_preserves_full_recall() {
+        let query = "James Webb Space Telescope";
+        let mut primary = outcomes(query, 12, "example.org");
+        let tasks = vec![
+            task(true, 20, primary.remove(0)),
+            task(true, 50, primary.remove(0)),
+            task(false, 2500, outcomes(query, 12, "example.org").remove(0)),
+        ];
+        let start = tokio::time::Instant::now();
+        let results = collect(tasks, query, Intent::Web, 8, false).await;
+        assert_eq!(results.len(), 3);
+        assert_eq!(start.elapsed(), std::time::Duration::from_millis(2500));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn weak_primary_results_wait_for_the_original_concurrent_recall() {
+        let query = "James Webb Space Telescope";
+        let mut primary = outcomes(query, 2, "example.org");
+        let tasks = vec![
+            task(true, 20, primary.remove(0)),
+            task(true, 50, primary.remove(0)),
+            task(false, 2500, outcomes(query, 12, "example.org").remove(0)),
+        ];
+        let start = tokio::time::Instant::now();
+        let results = collect(tasks, query, Intent::Web, 8, true).await;
+        assert_eq!(results.len(), 3);
+        assert_eq!(start.elapsed(), std::time::Duration::from_millis(2500));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn completed_recall_is_retained_and_primary_verticals_are_awaited() {
+        let query = "James Webb Space Telescope";
+        let mut primary = outcomes(query, 12, "example.org");
+        let mut vertical = outcomes(query, 12, "example.org").remove(0);
+        vertical.0 = "wikipedia".into();
+        let tasks = vec![
+            task(true, 20, primary.remove(0)),
+            task(true, 50, primary.remove(0)),
+            task(true, 80, vertical),
+            task(false, 10, outcomes(query, 12, "example.org").remove(0)),
+            task(false, 2500, outcomes(query, 12, "example.org").remove(0)),
+        ];
+        let start = tokio::time::Instant::now();
+        let results = collect(tasks, query, Intent::Web, 8, true).await;
+        assert_eq!(results.len(), 4);
+        assert!(results.iter().any(|(engine, _)| engine == "wikipedia"));
+        assert_eq!(start.elapsed(), std::time::Duration::from_millis(80));
+    }
+
+    fn outcomes(query: &str, count: usize, host: &str) -> Vec<(String, EngineResult)> {
+        let hits: Vec<_> = (0..count)
+            .map(|i| Hit {
+                title: format!("{query} reference {i}"),
+                snippet: query.into(),
+                url: if i == 0 {
+                    format!("https://{host}/article")
+                } else {
+                    format!("https://example{i}.org/article")
+                },
+                rank: i + 1,
+                published: None,
+            })
+            .collect();
+        ["bing", "yahoo"]
+            .into_iter()
+            .map(|engine| {
+                (
+                    engine.into(),
+                    Ok((hits.clone(), 1, "direct".into(), true, None)),
+                )
+            })
+            .collect()
+    }
+
+    #[test]
+    fn healthy_primary_results_skip_paced_followups() {
+        let query = "what is the James Webb Space Telescope";
+        assert!(!needed(
+            query,
+            Intent::Web,
+            8,
+            &outcomes(query, 12, "example.org")
+        ));
+    }
+
+    #[test]
+    fn weak_thin_or_single_backend_results_keep_recall() {
+        let query = "James Webb Space Telescope";
+        assert!(needed(
+            query,
+            Intent::Web,
+            8,
+            &outcomes(query, 3, "example.org")
+        ));
+        assert!(needed(
+            query,
+            Intent::Web,
+            8,
+            &outcomes("unrelated recipe", 12, "example.org")
+        ));
+        assert!(needed(
+            query,
+            Intent::Web,
+            8,
+            &outcomes(query, 12, "example.org")[..1]
+        ));
+        assert!(needed(query, Intent::Web, 8, &[]));
+    }
+
+    #[test]
+    fn missing_official_sources_keep_recall_and_lookalikes_do_not_count() {
+        let query = "TypeScript discriminated union documentation";
+        assert!(needed(
+            query,
+            Intent::Code,
+            8,
+            &outcomes(query, 12, "example.org")
+        ));
+        assert!(needed(
+            query,
+            Intent::Code,
+            8,
+            &outcomes(query, 12, "typescriptlang.org.evil.example")
+        ));
+        assert!(!needed(
+            query,
+            Intent::Code,
+            8,
+            &outcomes(query, 12, "typescriptlang.org")
+        ));
+    }
+}
